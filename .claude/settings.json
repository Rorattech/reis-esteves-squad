{
  "permissions": {
    "allow": [
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(black:*)",
      "Bash(alembic:*)",
      "Bash(docker compose:*)",
      "Bash(pip install:*)",
      "Bash(npm install:*)",
      "Bash(npm run:*)",
      "Read(**)",
      "Edit(backend/**)",
      "Edit(orchestrator/**)",
      "Edit(frontend/src/**)",
      "Edit(prompts/**)",
      "Edit(infra/**)",
      "Edit(docs/**)"
    ],
    "deny": [
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(git push:*)",
      "Edit(.env)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/graphify-guard.sh\" search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/graphify-guard.sh\" read"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@superpowers-marketplace": true
  }
}
