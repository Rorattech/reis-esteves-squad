# ==============================================================================
# Squad Digital | Reis Esteves Advocacia — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA versione o arquivo .env — apenas este .env.example.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL (pgvector/pgvector:0.8.5-pg16-trixie)
# ------------------------------------------------------------------------------
# Superusuário de bootstrap do initdb — uso interno do container Postgres.
# NUNCA usado pela aplicação/Alembic (superuser sempre ignora Row Level Security).
POSTGRES_ADMIN_USER=postgres_admin
POSTGRES_ADMIN_PASSWORD=changeme_use_a_strong_password

# Usuário da aplicação — sem SUPERUSER, dono do banco (ver infra/postgres/init-app-role.sh).
DB_HOST=postgres
DB_PORT=5432
DB_NAME=squad_digital
DB_USER=squad_app
DB_PASSWORD=changeme_use_a_strong_password
# URL completa consumida pelo backend (SQLAlchemy assíncrono)
DATABASE_URL=postgresql+asyncpg://squad_app:changeme_use_a_strong_password@postgres:5432/squad_digital

# ------------------------------------------------------------------------------
# Redis (redis:7.4.10-alpine)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme_use_a_strong_password
REDIS_URL=redis://:changeme_use_a_strong_password@redis:6379/0

# ------------------------------------------------------------------------------
# n8n (n8nio/n8n:2.31.6) — automação interna, nunca exposta ao frontend
# ------------------------------------------------------------------------------
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_ENCRYPTION_KEY=changeme_generate_with_openssl_rand_hex_32
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme_use_a_strong_password
N8N_WEBHOOK_URL=http://n8n:5678/
GENERIC_TIMEZONE=America/Sao_Paulo
# n8n usa o mesmo PostgreSQL, em schema/banco dedicado
N8N_DB_NAME=n8n
N8N_DB_USER=n8n_app
N8N_DB_PASSWORD=changeme_use_a_strong_password

# ------------------------------------------------------------------------------
# Backend (FastAPI)
# ------------------------------------------------------------------------------
BACKEND_ENV=development
BACKEND_SECRET_KEY=changeme_generate_with_openssl_rand_hex_32
BACKEND_JWT_ALGORITHM=HS256
BACKEND_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
BACKEND_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
BACKEND_CORS_ORIGINS=http://localhost:3000
BACKEND_MAX_UPLOAD_MB=50
# Diretório privado dos originais de evidência (volume evidence_storage no
# docker-compose — nunca servido como estático)
EVIDENCE_STORAGE_DIR=/app/storage/evidence

# ------------------------------------------------------------------------------
# OCR gerenciado — Google Cloud Vision (ver docs/adr/0003-ocr-google-cloud-vision.md)
# ------------------------------------------------------------------------------
# Chave restrita à Cloud Vision API. Sem ela, imagens e PDFs escaneados falham
# de forma explícita — nunca há degradação silenciosa para um OCR local.
# ATENÇÃO: envia conteúdo de evidência para fora do Brasil (a Vision API não tem
# região brasileira). O tratamento da transferência internacional sob a LGPD
# está registrado no ADR acima.
GOOGLE_VISION_API_KEY=
# Teto de páginas submetidas a OCR por PDF escaneado (cada página é cobrada).
EXTRACTION_MAX_OCR_PAGES=10
# Abaixo deste patamar, o texto derivado é marcado como insuficiente e vai para
# conferência humana. O sistema não reprocessa nem "melhora" o texto com IA.
EXTRACTION_LOW_CONFIDENCE_THRESHOLD=0.75

# Chaves de modelos de IA (nunca hardcode no código — sempre via core/config.py)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# Frontend (Next.js)
# ------------------------------------------------------------------------------
# Em DEV, o frontend roda em container (infra/docker-compose.yml).
# Em PRODUÇÃO, o frontend é buildado e servido pela Netlify — esta variável é
# embutida no bundle em tempo de build e mora nas env vars do site na Netlify,
# não aqui (ver frontend/netlify.toml e docs/adr/0004-deploy-hostinger-netlify.md).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------------------------
# Produção — VPS Hostinger KVM 2 (infra/docker-compose.prod.yml + infra/Caddyfile)
# Usadas SÓ pelo stack de produção; em dev podem ficar em branco.
# ------------------------------------------------------------------------------
# Domínio da API. O DNS precisa apontar para a VPS ANTES do primeiro `up`,
# senão a Let's Encrypt não consegue validar e o Caddy fica em retry.
API_DOMAIN=api.exemplo.adv.br
# E-mail de contato do certificado (avisos de expiração da Let's Encrypt).
ACME_EMAIL=ti@exemplo.adv.br
# Processos uvicorn. 2 é o padrão para a KVM 2 (2 vCPU); o rate limit usa Redis
# como storage compartilhado, então múltiplos workers são seguros.
BACKEND_WORKERS=2
